{
  "name": "work-orgenizer",
  "private": true,
  "version": "2.17.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "generate:icons": "node scripts/generate-icons.mjs",
    "test:rls": "node supabase/tests/rls.test.mjs",
    "db:apply": "node supabase/apply.mjs",
    "db:reset": "node supabase/apply.mjs --reset",
    "db:verify": "node supabase/apply.mjs --verify",
    "db:bundle": "node supabase/apply.mjs --bundle",
    "test:auth": "node supabase/tests/auth.cloud.test.mjs",
    "test:client": "node supabase/tests/client.cloud.test.mjs",
    "test:cloud": "node supabase/tests/rls.cloud.test.mjs && node supabase/tests/auth.cloud.test.mjs && node supabase/tests/client.cloud.test.mjs && node supabase/tests/preferences.cloud.test.mjs && node supabase/tests/manager.cloud.test.mjs && node --experimental-strip-types supabase/tests/generate.cloud.test.mjs && node supabase/tests/edit.cloud.test.mjs && node supabase/tests/realtime.cloud.test.mjs && node supabase/tests/notifications.cloud.test.mjs && node supabase/tests/webauthn.cloud.test.mjs",
    "test:prefs": "node supabase/tests/preferences.cloud.test.mjs",
    "test:manager": "node supabase/tests/manager.cloud.test.mjs",
    "test:fixtures": "node --experimental-strip-types solver/tests/run-fixtures.mjs",
    "test:compare": "node --experimental-strip-types solver/tests/compare-engines.mjs",
    "solver:dev": "uvicorn main:app --app-dir solver --reload --port 8099",
    "test:generate": "node --experimental-strip-types supabase/tests/generate.cloud.test.mjs",
    "seed:testweek": "node supabase/tests/seed-testweek.mjs",
    "preview:week": "node --experimental-strip-types supabase/tests/preview-week.mjs",
    "preview:cpsat": "solver/.venv/Scripts/python solver/tests/preview_cpsat.py solver/tests/realweek.json",
    "test:edit": "node supabase/tests/edit.cloud.test.mjs",
    "test:realtime": "node supabase/tests/realtime.cloud.test.mjs",
    "test:notifications": "node supabase/tests/notifications.cloud.test.mjs",
    "test:webauthn": "node supabase/tests/webauthn.cloud.test.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "pg": "^8.22.0",
    "sharp": "^0.35.3",
    "supabase": "^2.111.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
