# Copy to .env.local (gitignored) and fill in.
# ---------------------------------------------------------------------------
# Frontend (Vite). ONLY VITE_-prefixed vars reach the browser bundle -- and
# everything here is safe to ship publicly. Do NOT use NEXT_PUBLIC_ prefixes.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# New Supabase projects issue `sb_publishable_...`. Older ones issue a legacy
# `anon` JWT. Either works -- both are browser-safe by design; RLS is what
# actually protects the data.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# mock   = in-browser greedy solver (no backend needed)
# remote = Supabase Edge Function -> Render CP-SAT service
VITE_SOLVER_MODE=mock

# Web Push. Public half of the VAPID key pair -- safe for the browser, needed
# by PushManager.subscribe(). The private half lives only in the
# send-notifications Edge Function's secrets, never here.
# VITE_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY. Never prefix with VITE_ -- that would publish them.
# ---------------------------------------------------------------------------

# Direct Postgres connection, used by `npm run db:apply` to run migrations.
# Supabase dashboard -> Connect -> Session pooler (IPv4-friendly).
# CONTAINS THE DATABASE PASSWORD.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Secret key (`sb_secret_...`, formerly service_role). Bypasses ALL RLS --
# treat as a root password. Belongs only in Edge Function secrets.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# SOLVER_URL=https://guard-solver.onrender.com/solve
# SOLVER_SECRET=  # shared bearer token between the Edge Function and Render
